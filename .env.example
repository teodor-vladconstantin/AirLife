# Copy to .env.production and fill in. Everything is optional: missing key = feature off.
VITE_COMING_SOON=true
VITE_GTAG_ID=G-XXXXXXXXXX
# PostHog (Next.js reads these variables; legacy VITE_POSTHOG_* names remain supported below.)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# PostHog source map upload (build-time only)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=your_posthog_project_id
POSTHOG_HOST=https://your-posthog-app-host.example
VITE_POSTHOG_KEY=phc_xxx
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SENTRY_DSN=https://xxx@oXXXX.ingest.sentry.io/XXXX
