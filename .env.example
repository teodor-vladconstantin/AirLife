# Copiaza in .env (local) si completeaza cu valorile proiectului tau Supabase.
# Nu comite niciodata .env.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Cheia "anon"/publishable din Supabase (publica prin design; securitatea vine din RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Optional: "true" ascunde site-ul (raman accesibile doar /auth si /admin)
VITE_COMING_SOON=false
